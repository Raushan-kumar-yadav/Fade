{
    "name": "fade",
    "version": "1.0.0",
    "description": "AI Video Editor - Fade",
    "author": "Fade Team",
    "main": "dist-electron/main.js",
    "scripts": {
        "predev": "node scripts/killports.js",
        "build:electron": "tsc -p tsconfig.node.json && node -e \"const fs=require('fs');fs.copyFileSync('electron/splash.html','dist-electron/splash.html');fs.copyFileSync('electron/devlog.html','dist-electron/devlog.html')\"",
        "dev": "concurrently \"vite\" \"npm run build:electron && wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
        "build": "vite build && npm run build:electron",
        "start": "electron . --remote-debugging-port=9222",
        "build:native": "cmake-js compile --directory renderer --out renderer/build",
        "dist": "npm run build && electron-builder build --win --publish never"
    },
    "build": {
        "appId": "com.fade.videoeditor",
        "productName": "Fade",
        "asar": false,
        "win": {
            "target": [
                {
                    "target": "dir",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "directories": {
            "output": "dist-app"
        },
        "files": [
            "dist/**",
            "dist-electron/**",
            "!node_modules/**",
            "!backend/**",
            "!.venv/**",
            "!src/**",
            "!electron/**"
        ],
        "extraResources": [
            {
                "from": "pyinstaller-dist/backend",
                "to": "backend",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "renderer/build/Release",
                "to": "renderer/build/Release",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "backend/timeline/effects/sksl",
                "to": "backend/timeline/effects/sksl",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "templates",
                "to": "templates",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "AIModels/kokoro",
                "to": "AIModels/kokoro",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": ".env",
                "to": ".env"
            },
            {
                "from": "AIModels",
                "to": "AIModels",
                "filter": [
                    "**/*"
                ]
            }
        ]
    },
    "dependencies": {
        "allotment": "^1.20.5",
        "flexlayout-react": "^0.10.5",
        "react": "^18.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^4.2.0",
        "cmake-js": "^8.0.0",
        "concurrently": "^8.2.0",
        "cross-env": "^7.0.3",
        "electron": "^29.0.0",
        "electron-builder": "^26.0.12",
        "node-addon-api": "^8.9.2",
        "playwright": "^1.63.0",
        "puppeteer": "^25.12.0",
        "react-dom": "^18.3.1",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vite": "^5.1.0",
        "wait-on": "^7.2.0"
    }
}


