# ─────────────────────────────────────────────────────────────────────────────
# Echo – Environment Variables
# Copy this file to `.env` and fill in your keys.
# The app reads this file at startup; settings are also editable via the
# Settings panel inside the app (Settings → API Keys / Agent / Indexing).
# ─────────────────────────────────────────────────────────────────────────────


# ── Agent AI Provider ─────────────────────────────────────────────────────────
# Which provider powers the AI Director / Agent.
# Options: ollama | openai | google | anthropic | groq | openrouter | tokenrouter | tabi
ECHO_AI_PROVIDER=ollama

# Default model for the chosen provider (e.g. llama3.2, gpt-4o, gemini-1.5-flash)
ECHO_AI_MODEL=llama3.2


# ── Google (Gemini) ───────────────────────────────────────────────────────────
# Used for: Agent AI (provider=google), Image generation, Video Indexing (Gemini)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=


# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used for: Agent AI (provider=openai)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Used for: Agent AI (provider=anthropic)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: custom base URL (e.g. for a proxy)
# ANTHROPIC_BASE_URL=https://api.anthropic.com


# ── Groq ──────────────────────────────────────────────────────────────────────
# Used for: Agent AI (provider=groq) — very fast inference
# Get key: https://console.groq.com/keys
GROQ_API_KEY=


# ── OpenRouter ────────────────────────────────────────────────────────────────
# Used for: Agent AI (provider=openrouter) — access 200+ models
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ── TokenRouter ───────────────────────────────────────────────────────────────
# Used for: Agent AI (provider=tokenrouter) — token-efficient routing
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1


# ── Tabi API ──────────────────────────────────────────────────────────────────
# Used for: Agent AI (provider=tabi) — custom/internal provider
TABI_API_KEY=
TABI_BASE_URL=


# ── Stability AI ──────────────────────────────────────────────────────────────
# Used for: Image generation (Settings → Image Gen → Stability AI)
# Get key: https://platform.stability.ai/account/keys
STABILITY_API_KEY=


# ── YouTube Data API ──────────────────────────────────────────────────────────
# Used for: YouTube video download & metadata (yt-dlp integration)
# Get key: https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=


 