// zoom_in.sksl — B zooms in from center over A
// At progress=0: A full, B invisible; at progress=1: B full, A hidden
uniform shader srcA;
uniform shader srcB;
uniform float  progress;
uniform float  scale_start;   // scale factor at start, e.g. 0.3
uniform float2 resolution;

half4 main(float2 xy) {
    half4 a = srcA.eval(xy);

    // Compute scale of B: from scale_start to 1.0
    float scale = mix(scale_start, 1.0, progress);
    // Sample B with centered scale
    float2 center = resolution * 0.5;
    float2 bXY = center + (xy - center) / scale;
    half4 b = srcB.eval(bXY);

    // Fade B in over A
    return mix(a, b, half(progress));
}
