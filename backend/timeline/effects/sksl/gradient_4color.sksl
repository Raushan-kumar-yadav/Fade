uniform shader source;
uniform float2 point1;
uniform float4 color1;
uniform float2 point2;
uniform float4 color2;
uniform float2 point3;
uniform float4 color3;
uniform float2 point4;
uniform float4 color4;
uniform float blendPower;
uniform float opacity;
uniform float viewOverlay;
// Injected by Compositor: the solid's top-left corner in canvas buffer pixels.
// pointN are authored in clip-local space; adding _clipOrigin converts them
// to canvas space so gradient positions stay relative to the clip.
uniform float _clipOriginX;
uniform float _clipOriginY;

half4 main(float2 coord) {
    half4 dst = source.eval(coord);
    
    // Convert clip-local point coords to canvas space by adding the clip origin.
    float2 p1 = float2(_clipOriginX, _clipOriginY) + point1;
    float2 p2 = float2(_clipOriginX, _clipOriginY) + point2;
    float2 p3 = float2(_clipOriginX, _clipOriginY) + point3;
    float2 p4 = float2(_clipOriginX, _clipOriginY) + point4;
    
    // Inverse distance weighting
    float d1 = max(length(coord - p1), 1.0);
    float d2 = max(length(coord - p2), 1.0);
    float d3 = max(length(coord - p3), 1.0);
    float d4 = max(length(coord - p4), 1.0);
    
    float w1 = 1.0 / pow(d1, blendPower);
    float w2 = 1.0 / pow(d2, blendPower);
    float w3 = 1.0 / pow(d3, blendPower);
    float w4 = 1.0 / pow(d4, blendPower);
    
    float sumW = w1 + w2 + w3 + w4;
    
    // Premultiply the colors
    half4 c1 = half4(color1.rgb, 1.0) * color1.a;
    half4 c2 = half4(color2.rgb, 1.0) * color2.a;
    half4 c3 = half4(color3.rgb, 1.0) * color3.a;
    half4 c4 = half4(color4.rgb, 1.0) * color4.a;
    
    // Interpolated gradient color
    half4 gradColor = (c1 * w1 + c2 * w2 + c3 * w3 + c4 * w4) / sumW;
    
    // Apply overall opacity
    gradColor *= opacity;
    
    // Mask the gradient to the clip's alpha
    gradColor *= dst.a;
    
    // Source-Over blend formula
    half4 result = gradColor + dst * (1.0 - gradColor.a);
    
    // viewOverlay is now handled by the Compositor as a post-effects Skia
    // draw pass, so it is never displaced/warped by subsequent effects.
    // The uniform is kept here so fillUniforms() can set it without errors.
    
    return result;
}
